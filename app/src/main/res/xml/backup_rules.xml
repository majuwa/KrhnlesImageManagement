<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude credentials from cloud backup -->
    <exclude domain="file" path="datastore/credentials.preferences_pb"/>
    <exclude domain="sharedpref" path="krhnles_secure.xml"/>
    <!-- Restored device without credentials must see onboarding again -->
    <exclude domain="file" path="datastore/app_preferences.preferences_pb"/>
    <!-- MediaStore ids are device-specific: a restored set would mark wrong photos -->
    <exclude domain="file" path="datastore/uploaded_photos.preferences_pb"/>
    <!-- Folder names are user-written and may be sensitive -->
    <exclude domain="file" path="datastore/upload_history.preferences_pb"/>
    <!-- Device-specific MediaStore ids and uris of verified uploads: a restored set would be wrong -->
    <exclude domain="file" path="datastore/verified_uploads.preferences_pb"/>
</full-backup-content>